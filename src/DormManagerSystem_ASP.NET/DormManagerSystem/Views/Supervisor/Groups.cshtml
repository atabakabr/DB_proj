@model IEnumerable<DormWeb.Models.SupervisorGroupItem>
@{
    ViewData["Title"] = "گروه‌ها";
    Layout = null;
    var prevDisabled = (int)ViewBag.Page <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = (int)ViewBag.Page >= (int)ViewBag.TotalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>گروه‌ها | سرپرست</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center
                }

                    .sidebar a:hover {
                        background: #0056b3
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem;
                margin-bottom: 1.5rem
            }

            .btn {
                padding: .4rem .8rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold;
                text-decoration: none;
                font-size: .85rem
            }

            .btn-primary {
                background: #007bff;
                color: white
            }

            .btn-success {
                background: #28a745;
                color: white
            }

            .btn-danger {
                background: #dc3545;
                color: white
            }

            .btn-secondary {
                background: #6c757d;
                color: white
            }

            .form-row {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
                align-items: flex-end
            }

            .form-group {
                flex: 1 1 200px;
                margin-bottom: .5rem
            }

                .form-group label {
                    display: block;
                    font-weight: bold;
                    margin-bottom: .3rem
                }

                .form-group input, .form-group select {
                    width: 100%;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px
                }

            .member-list {
                display: flex;
                flex-wrap: wrap;
                gap: .5rem;
                margin-top: .5rem
            }

            .member-tag {
                background: #e7f3ff;
                padding: .3rem .6rem;
                border-radius: 6px;
                font-size: .85rem;
                display: flex;
                align-items: center;
                gap: .5rem
            }

                .member-tag button {
                    background: none;
                    border: none;
                    color: red;
                    cursor: pointer;
                    font-weight: bold
                }

            table {
                width: 100%;
                border-collapse: collapse
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right
            }

            th {
                background: #f8f8f8
            }

            .pagination {
                display: flex;
                justify-content: center;
                gap: .5rem;
                margin-top: 1rem
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333
                }

                    .pagination a:hover {
                        background: #007bff;
                        color: white
                    }

                .pagination .current {
                    background: #007bff;
                    color: white
                }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details"><strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong><small>کد: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل سرپرست</h2>
            <a href="/Supervisor/Index"> داشبورد</a>
            <a href="/Supervisor/Students"> دانشجویان</a>
            <a href="/Supervisor/Payments"> پرداخت‌ها</a>
            <a href="/Supervisor/Groups" style="background:#0056b3;"> گروه‌ها</a>
            <a href="/Supervisor/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Supervisor/Announcements"> اطلاعیه‌ها</a>
            <a href="/Supervisor/Reports"> گزارش‌ها</a>
            <a href="/Supervisor/Profile"> پروفایل</a>
        </div>
        <div class="main">
            @if (TempData["Msg"] != null)
            {
                <div style="background:#d4edda;color:#155724;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Msg"]</div>
            }
            @if (TempData["Err"] != null)
            {
                <div style="background:#f8d7da;color:#721c24;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Err"]</div>
            }

            <div class="card">
                <h3>➕ ایجاد گروه جدید</h3>
                <form method="post" action="/Supervisor/CreateGroup" id="createGroupForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label>نوع گروه</label>
                            <select name="GroupType" required>
                                <option value="">انتخاب...</option>
                                <option value="M">پسرانه</option>
                                <option value="F">دخترانه</option>
                                <option value="Married">متاهلی</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>بلوک</label>
                            <select name="BlockID" id="blockSelect" required onchange="loadRooms()">
                                <option value="">انتخاب بلوک</option>
                                @foreach (var b in (ViewBag.Blocks as IEnumerable<DormWeb.Models.BlockItem>) ?? new List<DormWeb.Models.BlockItem>())
                                {
                                    <option value="@b.BlockID">@b.BName (@b.DormitoryName)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>اتاق</label>
                            <select name="RoomID" id="roomSelect">
                                <option value="">بدون اتاق</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex:2">
                            <label>افزودن عضو</label>
                            <div style="display:flex;gap:.5rem">
                                <input type="number" id="newStudentId" placeholder="شماره دانشجویی" style="flex:1">
                                <button type="button" class="btn btn-primary" onclick="addMember()">➕</button>
                            </div>
                            <input type="hidden" name="StudentIDs" id="studentIdsHidden">
                            <div class="member-list" id="memberList"></div>
                        </div>
                        <div class="form-group">
                            <label>نماینده (سرگروه)</label>
                            <select name="LeaderStudentID" id="leaderSelect">
                                <option value="">انتخاب از اعضا</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success">ثبت گروه</button>
                </form>
            </div>

            <div class="card">
                <h3>📋 گروه‌های موجود</h3>
                <form method="get" class="form-row" style="margin-bottom:1rem">
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="جستجوی شماره گروه یا نام سرگروه..." style="flex:1;padding:.5rem;border:1px solid #ccc;border-radius:4px">
                    <button type="submit" class="btn btn-primary">جستجو</button>
                    <a href="/Supervisor/Groups" class="btn btn-secondary">پاک کردن</a>
                </form>
                <table>
                    <thead><tr><th>شماره گروه</th><th>نام نماینده (سرگروه)</th><th>نوع گروه</th><th>بلوک</th><th>اتاق</th><th>تعداد اعضا</th><th>عملیات</th></tr></thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var g in Model)
                            {
                                <tr>
                                    <td>@g.GroupID</td>
                                    <td>@(g.LeaderName != null ? $"{g.LeaderName} ({g.LeaderID})" : "-")</td>
                                    <td>@(g.GroupType == "M" ? "پسرانه" : g.GroupType == "F" ? "دخترانه" : "متاهلی")</td>
                                    <td>@g.BlockName</td>
                                    <td>@g.RoomName</td>
                                    <td>@g.MemberCount نفر</td>
                                    <td>
                                        <form method="post" action="/Supervisor/DeleteGroup" style="display:inline" onsubmit="return confirm('حذف شود؟')">
                                            <input type="hidden" name="groupId" value="@g.GroupID">
                                            <button class="btn btn-danger btn-sm">حذف</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" style="text-align:center;padding:2rem;">گروهی یافت نشد.</td></tr>
                        }
                    </tbody>
                </table>
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Supervisor/Groups?search=@ViewBag.Search&page=@(ViewBag.Page - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.Page)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Supervisor/Groups?search=@ViewBag.Search&page=@i">@i</a>
                            }
                        }
                        <a href="/Supervisor/Groups?search=@ViewBag.Search&page=@(ViewBag.Page + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center;margin-top:.5rem;color:#888;">نمایش @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>

    <script>
            let members = [];
            async function loadRooms() {
                const blockId = document.getElementById('blockSelect').value;
                const roomSel = document.getElementById('roomSelect');
                roomSel.innerHTML = '<option value="">بدون اتاق</option>';
                if (!blockId) return;
                const res = await fetch('/Supervisor/GetRoomsByBlock?blockId=' + blockId);
                const rooms = await res.json();
                rooms.forEach(r => {
                    roomSel.innerHTML += `<option value="${r.RoomID}">${r.NameRoom} (ظرفیت ${r.Capacity})</option>`;
                });
            }
            function addMember() {
                const input = document.getElementById('newStudentId');
                const sid = input.value.trim();
                if (!sid || members.includes(sid)) { alert('شماره تکراری یا خالی'); return; }
                members.push(sid);
                updateMemberList();
                input.value = '';
            }
            function removeMember(sid) {
                members = members.filter(m => m !== sid);
                updateMemberList();
            }
            function updateMemberList() {
                const container = document.getElementById('memberList');
                const leaderSel = document.getElementById('leaderSelect');
                container.innerHTML = members.map(m => `<span class="member-tag">${m} <button onclick="removeMember('${m}')">✖</button></span>`).join('');
                document.getElementById('studentIdsHidden').value = members.join(',');
                leaderSel.innerHTML = '<option value="">انتخاب از اعضا</option>' + members.map(m => `<option value="${m}">${m}</option>`).join('');
            }
            document.getElementById('createGroupForm').addEventListener('submit', function(e) {
                document.getElementById('studentIdsHidden').value = members.join(',');
            });
    </script>
</body>
</html>