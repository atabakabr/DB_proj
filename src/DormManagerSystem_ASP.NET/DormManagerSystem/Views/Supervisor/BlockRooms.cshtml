@model IEnumerable<DormWeb.Models.RoomViewModel>
@{
    ViewData["Title"] = "اتاق‌های خالی";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>اتاق‌های خالی | @ViewBag.BlockName</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center
                }

                    .sidebar a:hover {
                        background: #0056b3
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem
            }

            .room-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill,minmax(220px,1fr));
                gap: 1rem
            }

            .room-card {
                background: linear-gradient(135deg,#e0f7fa,#e8f5e9);
                border-radius: 10px;
                padding: 1rem;
                border-left: 4px solid #007bff
            }

                .room-card h4 {
                    margin-bottom: .5rem;
                    color: #007bff
                }

                .room-card p {
                    margin: .2rem 0;
                    font-size: .9rem;
                    color: #555
                }

            .badge-capacity {
                display: inline-block;
                padding: .2rem .8rem;
                border-radius: 20px;
                font-size: .8rem;
                background: #d4edda;
                color: #155724;
                margin-top: .5rem
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details"><strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong><small>کد: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل سرپرست</h2>
            <a href="/Supervisor/Index"> داشبورد</a>
            <a href="/Supervisor/Students"> دانشجویان</a>
            <a href="/Supervisor/Payments"> پرداخت‌ها</a>
            <a href="/Supervisor/Groups"> گروه‌ها</a>
            <a href="/Supervisor/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Supervisor/Announcements"> اطلاعیه‌ها</a>
            <a href="/Supervisor/Reports"> گزارش‌ها</a>
            <a href="/Supervisor/Profile"> پروفایل</a>
        </div>
        <div class="main">
            <h2>اتاق‌های خالی بلوک @ViewBag.BlockName</h2>
            <a href="/Supervisor/Index" style="margin-bottom:1rem;display:inline-block;">⬅️ بازگشت</a>
            <div class="room-grid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var r in Model)
                    {
                        <div class="room-card">
                            <h4> @r.NameRoom</h4>
                            <p>ظرفیت کل: @r.Capacity</p>
                            <span class="badge-capacity">🟢 @r.AvailableCapacity جای خالی</span>
                        </div>
                    }
                }
                else
                {
                    <p>اتاق خالی‌ای در این بلوک وجود ندارد.</p>
                }
            </div>
        </div>
    </div>
</body>
</html>