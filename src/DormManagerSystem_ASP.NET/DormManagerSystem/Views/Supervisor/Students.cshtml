@model IEnumerable<DormWeb.Models.SupervisorStudentItem>
@{
    ViewData["Title"] = "دانشجویان";
    Layout = null;
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var prevDisabled = currentPage <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = currentPage >= totalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دانشجویان | سرپرست</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center
                }

                    .sidebar a:hover {
                        background: #0056b3
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem;
                margin-bottom: 1.5rem
            }

            .search-box {
                margin-bottom: 1rem;
                display: flex;
                gap: .5rem
            }

                .search-box input {
                    flex: 1;
                    max-width: 400px;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px
                }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold;
                text-decoration: none
            }

            .btn-primary {
                background: #007bff;
                color: white
            }

            .btn-secondary {
                background: #6c757d;
                color: white
            }

            .btn-success {
                background: #28a745;
                color: white
            }

            .btn-danger {
                background: #dc3545;
                color: white
            }

            .form-row {
                display: flex;
                gap: 1rem;
                align-items: flex-end;
                flex-wrap: wrap
            }

            .form-group {
                flex: 1 1 200px
            }

                .form-group label {
                    display: block;
                    font-weight: bold;
                    margin-bottom: .3rem
                }

                .form-group input, .form-group select {
                    width: 100%;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px
                }

            table {
                width: 100%;
                border-collapse: collapse
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right
            }

            th {
                background: #f8f8f8
            }

            .pagination {
                display: flex;
                justify-content: center;
                gap: .5rem;
                margin-top: 1rem
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333
                }

                    .pagination a:hover {
                        background: #007bff;
                        color: white
                    }

                .pagination .current {
                    background: #007bff;
                    color: white
                }

            .alert-success {
                background: #d4edda;
                color: #155724;
                padding: .5rem;
                border-radius: 4px;
                margin-bottom: 1rem
            }

            .alert-error {
                background: #f8d7da;
                color: #721c24;
                padding: .5rem;
                border-radius: 4px;
                margin-bottom: 1rem
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details"><strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong><small>کد: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل سرپرست</h2>
            <a href="/Supervisor/Index"> داشبورد</a>
            <a href="/Supervisor/Students" style="background:#0056b3;"> دانشجویان</a>
            <a href="/Supervisor/Payments"> پرداخت‌ها</a>
            <a href="/Supervisor/Groups"> گروه‌ها</a>
            <a href="/Supervisor/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Supervisor/Announcements"> اطلاعیه‌ها</a>
            <a href="/Supervisor/Reports"> گزارش‌ها</a>
            <a href="/Supervisor/Profile"> پروفایل</a>
        </div>
        <div class="main">
            @if (TempData["Msg"] != null)
            {
                <div class="alert-success">@TempData["Msg"]</div>
            }
            @if (TempData["Err"] != null)
            {
                <div class="alert-error">@TempData["Err"]</div>
            }

            <div class="card">
                <h3>➕ افزودن دانشجو به اتاق</h3>
                <form method="post" action="/Supervisor/AddStudentToRoom">
                    <div class="form-row">
                        <div class="form-group"><label>شماره دانشجویی</label><input type="number" name="studentId" required></div>
                        <div class="form-group">
                            <label>نام اتاق</label>
                            <input type="text" name="roomName" placeholder="مثلاً اتاق 101" required>
                        </div>
                        <div class="form-group"><button type="submit" class="btn btn-success">افزودن</button></div>
                    </div>
                </form>
            </div>

            <div class="card">
                <h3>➖ حذف دانشجو از اتاق</h3>
                <form method="post" action="/Supervisor/RemoveStudentFromRoom">
                    <div class="form-row">
                        <div class="form-group">
                            <label>شماره دانشجویی</label>
                            <input type="number" name="studentId" required>
                        </div>
                        <div class="form-group">
                            <label>نام اتاق</label>
                            <input type="text" name="roomName" placeholder="مثلاً اتاق 101" required>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-danger">حذف</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card">
                <h3>📋 دانشجویان تحت نظارت</h3>
                <form method="get" class="search-box">
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="جستجوی نام یا شماره دانشجویی...">
                    <button type="submit" class="btn btn-primary">جستجو</button>
                    <a href="/Supervisor/Students" class="btn btn-secondary">پاک کردن</a>
                </form>
                <table>
                    <thead><tr><th>کد</th><th>نام</th><th>موبایل</th><th>اتاق</th><th>بلوک</th></tr></thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var s in Model)
                            {
                                <tr><td>@s.StudentID</td><td>@s.FirstName @s.LastName</td><td>@s.MobilePhoneNumber</td><td>@s.RoomName</td><td>@s.BlockName</td></tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" style="text-align:center;padding:2rem;">دانشجویی یافت نشد.</td></tr>
                        }
                    </tbody>
                </table>
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Supervisor/Students?search=@ViewBag.Search&page=@(currentPage - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == currentPage)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Supervisor/Students?search=@ViewBag.Search&page=@i">@i</a>
                            }
                        }
                        <a href="/Supervisor/Students?search=@ViewBag.Search&page=@(currentPage + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center;margin-top:.5rem;color:#888;">نمایش @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>
</body>
</html>