@model IEnumerable<DormWeb.Models.SupervisorReportItem>
@{
    ViewData["Title"] = "گزارش‌ها";
    Layout = null;
    var prevDisabled = (int)ViewBag.Page <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = (int)ViewBag.Page >= (int)ViewBag.TotalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>گزارش‌ها | سرپرست</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center
                }

                    .sidebar a:hover {
                        background: #0056b3
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem
            }

            .search-box {
                margin-bottom: 1rem;
                display: flex;
                gap: .5rem
            }

                .search-box input {
                    flex: 1;
                    max-width: 400px;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px
                }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold;
                text-decoration: none
            }

            .btn-primary {
                background: #007bff;
                color: white
            }

            .btn-secondary {
                background: #6c757d;
                color: white
            }

            .btn-danger {
                background: #dc3545;
                color: white
            }

            table {
                width: 100%;
                border-collapse: collapse
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right
            }

            th {
                background: #f8f8f8
            }

            .pagination {
                display: flex;
                justify-content: center;
                gap: .5rem;
                margin-top: 1rem
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333
                }

                    .pagination a:hover {
                        background: #007bff;
                        color: white
                    }

                .pagination .current {
                    background: #007bff;
                    color: white
                }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details"><strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong><small>کد: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل سرپرست</h2>
            <a href="/Supervisor/Index"> داشبورد</a>
            <a href="/Supervisor/Students"> دانشجویان</a>
            <a href="/Supervisor/Payments"> پرداخت‌ها</a>
            <a href="/Supervisor/Groups"> گروه‌ها</a>
            <a href="/Supervisor/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Supervisor/Announcements"> اطلاعیه‌ها</a>
            <a href="/Supervisor/Reports" style="background:#0056b3;"> گزارش‌ها</a>
            <a href="/Supervisor/Profile"> پروفایل</a>
        </div>
        <div class="main">
            @if (TempData["Msg"] != null)
            {
                <div style="background:#d4edda;color:#155724;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Msg"]</div>
            }
            <div class="card">
                <h3>📋 گزارش‌های ثبت‌شده</h3>
                <form method="get" class="search-box">
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="جستجوی عنوان، اتاق، یا شماره دانشجو...">
                    <button type="submit" class="btn btn-primary">جستجو</button>
                    <a href="/Supervisor/Reports" class="btn btn-secondary">پاک کردن</a>
                </form>
                <table>
                    <thead><tr><th>کد</th><th>عنوان</th><th>نوع</th><th>تاریخ</th><th>هدف</th><th>دانشجو</th><th>توضیحات</th><th></th></tr></thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td>@r.RID</td>
                                    <td>@r.Title</td>
                                    <td>@r.Type</td>
                                    <td>@r.Date.ToString("yyyy/MM/dd")</td>
                                    <td>@r.Target</td>
                                    <td>@r.StudentName</td>
                                    <td>@r.Description</td>
                                    <td>
                                        <form method="post" action="/Supervisor/DeleteReport" onsubmit="return confirm('حذف شود؟')">
                                            <input type="hidden" name="rid" value="@r.RID">
                                            <button class="btn btn-danger btn-sm">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="8" style="text-align:center;padding:2rem;">گزارشی یافت نشد.</td></tr>
                        }
                    </tbody>
                </table>
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Supervisor/Reports?search=@ViewBag.Search&page=@(ViewBag.Page - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.Page)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Supervisor/Reports?search=@ViewBag.Search&page=@i">@i</a>
                            }
                        }
                        <a href="/Supervisor/Reports?search=@ViewBag.Search&page=@(ViewBag.Page + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center;margin-top:.5rem;color:#888;">نمایش @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>
</body>
</html>