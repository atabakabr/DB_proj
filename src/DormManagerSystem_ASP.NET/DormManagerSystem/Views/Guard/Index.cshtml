@model IEnumerable<DormWeb.Models.StudentGuardViewModel>
@{
    ViewData["Title"] = "لیست دانشجویان";
    Layout = null;

    var prevDisabled = (int)ViewBag.CurrentPage <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = (int)ViewBag.CurrentPage >= (int)ViewBag.TotalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لیست دانشجویان | پنل نگهبان</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: Tahoma, sans-serif;
                background: #f4f6f9;
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem;
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem;
            }

            .user-details strong {
                font-size: .95rem;
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px);
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem;
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333;
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s;
                }

                    .sidebar a:hover {
                        background: #0056b3;
                    }

            .main {
                flex: 1;
                padding: 2rem;
            }

            .list-card {
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1rem;
            }

            .search-box {
                margin-bottom: 1rem;
                display: flex;
                gap: 0.5rem;
            }

                .search-box input {
                    flex: 1;
                    max-width: 400px;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    font-family: inherit;
                }

            .btn-search {
                background: #007bff;
                color: white;
                border: none;
                padding: .5rem 1rem;
                border-radius: 4px;
                cursor: pointer;
            }

            .btn-reset {
                background: #6c757d;
                color: white;
                border: none;
                padding: .5rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .table-container {
                max-height: 500px;
                overflow-y: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

            th {
                background: #f8f8f8;
                position: sticky;
                top: 0;
                font-weight: bold;
            }

            .no-data {
                text-align: center;
                padding: 2rem;
                color: #888;
            }

            .pagination {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: .5rem;
                margin-top: 1rem;
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333;
                    background: white;
                }

                    .pagination a:hover {
                        background: #007bff;
                        color: white;
                        border-color: #007bff;
                    }

                .pagination .current {
                    background: #007bff;
                    color: white;
                    border-color: #007bff;
                }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details">
                <strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong>
                <small>کد پرسنلی: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل نگهبان</h2>
            <a href="/Guard/Index" style="background:#0056b3;">لیست دانشجویان</a>
            <a href="/Guard/TrafficReport">گزارش تردد</a>
            <a href="/Guard/PersonalInfo">اطلاعات فردی</a>
        </div>
        <div class="main">
            <h2>لیست دانشجویان</h2>
            <div class="list-card">
                <form method="get" class="search-box">
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="نام یا شماره دانشجویی...">
                    <button type="submit" class="btn-search">جستجو</button>
                    <a href="/Guard/Index" class="btn-reset">پاک کردن</a>
                </form>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>کد</th>
                                <th>نام</th>
                                <th>نام پدر</th>
                                <th>تلفن</th>
                                <th>تلفن والدین</th>
                                <th>استان</th>
                                <th>شهر</th>
                                <th>آدرس</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var student in Model)
                                {
                                    <tr>
                                        <td>@student.StudentID</td>
                                        <td>@student.FirstName @student.LastName</td>
                                        <td>@student.FatherName</td>
                                        <td>@student.StudentPhone</td>
                                        <td>@student.ParentPhone</td>
                                        <td>@student.Province</td>
                                        <td>@student.City</td>
                                        <td>@student.Address</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="8" class="no-data">دانشجویی یافت نشد.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Guard/Index?search=@ViewBag.Search&page=@(ViewBag.CurrentPage - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.CurrentPage)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Guard/Index?search=@ViewBag.Search&page=@i">@i</a>
                            }
                        }
                        <a href="/Guard/Index?search=@ViewBag.Search&page=@(ViewBag.CurrentPage + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div class="text-center text-muted mt-2">نمایش @Model.Count() از @ViewBag.TotalCount دانشجو</div>
                }
            </div>
        </div>
    </div>
</body>
</html>