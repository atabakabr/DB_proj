@model IEnumerable<DormWeb.Models.RoomViewModel>
@{
    ViewData["Title"] = "رزرو اتاق";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رزرو اتاق | پنل مدیر</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: Tahoma, sans-serif;
                background: #f4f6f9;
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem;
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem;
            }

            .user-details strong {
                font-size: .95rem;
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px);
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem;
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333;
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s;
                }

                    .sidebar a:hover {
                        background: #0056b3;
                    }

            .main {
                flex: 1;
                padding: 2rem;
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem;
                margin-bottom: 1.5rem;
            }

                .card h3 {
                    margin-bottom: 1rem;
                }

            .form-row {
                display: flex;
                gap: 1rem;
                align-items: flex-end;
                flex-wrap: wrap;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: .3rem;
                flex: 1 1 200px;
            }

                .form-group label {
                    font-weight: bold;
                    font-size: .9rem;
                }

                .form-group input {
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    font-family: inherit;
                }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold;
            }

            .btn-primary {
                background: #007bff;
                color: white;
            }

            .btn-danger {
                background: #dc3545;
                color: white;
            }

            .btn-secondary {
                background: #6c757d;
                color: white;
            }

            .alert-success {
                background: #d4edda;
                color: #155724;
                padding: .5rem;
                border-radius: 4px;
                margin-bottom: 1rem;
            }

            .alert-error {
                background: #f8d7da;
                color: #721c24;
                padding: .5rem;
                border-radius: 4px;
                margin-bottom: 1rem;
            }

            .search-box {
                margin-bottom: 1rem;
            }

                .search-box input {
                    width: 100%;
                    max-width: 400px;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                }

            .table-container {
                overflow-y: auto;
                max-height: 400px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

            th {
                background: #f8f8f8;
                position: sticky;
                top: 0;
                font-weight: bold;
            }

            .no-data {
                text-align: center;
                padding: 2rem;
                color: #888;
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details">
                <strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong>
                <small>کد پرسنلی: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل مدیر</h2>
            <a href="/Manager/Index"> داشبورد</a>
            <a href="/Manager/Students"> دانشجویان</a>
            <a href="/Manager/ReserveRoom" style="background:#0056b3;"> رزرو اتاق</a>
            <a href="/Manager/Dormitories"> خوابگاه‌ها</a>
            <a href="/Manager/Blocks"> بلوک‌ها</a>
            <a href="/Manager/Rooms" > اتاق‌ها</a>
            <a href="/Manager/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Manager/Staffs"> کارکنان</a>
            <a href="/Manager/Profile"> پروفایل</a>
            <a href="/Manager/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            @if (TempData["Msg"] != null)
            {
                <div class="alert-success">@TempData["Msg"]</div>
            }
            @if (TempData["Err"] != null)
            {
                <div class="alert-error">@TempData["Err"]</div>
            }

            <div class="card">
                <h3>➕ افزودن دانشجو به اتاق</h3>
                <form method="post" action="/Manager/AddStudentToRoom">
                    <div class="form-row">
                        <div class="form-group"><label>شماره دانشجویی</label><input type="number" name="studentId" required></div>
                        <div class="form-group"><label>شماره اتاق</label><input type="number" name="roomId" required></div>
                        <div class="form-group"><button type="submit" class="btn btn-primary">افزودن</button></div>
                    </div>
                </form>
            </div>

            <div class="card">
                <h3>➖ حذف دانشجو از اتاق</h3>
                <form method="post" action="/Manager/RemoveStudentFromRoom">
                    <div class="form-row">
                        <div class="form-group"><label>شماره دانشجویی</label><input type="number" name="studentId" required></div>
                        <div class="form-group"><label>نام اتاق</label><input type="text" name="roomName" placeholder="مثلاً اتاق 101" required></div>
                        <div class="form-group"><button type="submit" class="btn btn-danger">حذف</button></div>
                    </div>
                </form>
            </div>

            <div class="card">
                <h3>🏨 اتاق‌های خالی</h3>
                <div class="search-box">
                    <input type="text" id="roomSearch" placeholder="جستجوی خوابگاه، بلوک، یا اتاق...">
                </div>
                <div class="table-container">
                    <table id="roomsTable">
                        <thead>
                            <tr>
                                <th>شماره اتاق</th>
                                <th>ظرفیت کل</th>
                                <th>ظرفیت خالی</th>
                                <th>بلوک</th>
                                <th>خوابگاه</th>
                                <th>نوع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td>@r.RoomID</td>
                                        <td>@r.Capacity</td>
                                        <td>@r.AvailableCapacity</td>
                                        <td>@r.BlockName</td>
                                        <td>@r.DormitoryName</td>
                                        <td>@r.DormitoryType</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="no-data">اتاق خالی‌ای وجود ندارد.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
            const searchInput = document.getElementById('roomSearch');
            const tbody = document.getElementById('roomsTable').getElementsByTagName('tbody')[0];
            const rows = tbody.getElementsByTagName('tr');

            searchInput.addEventListener('input', function() {
                const term = searchInput.value.trim().toLowerCase();
                for (let i = 0; i < rows.length; i++) {
                    const rowText = rows[i].innerText.toLowerCase();
                    rows[i].style.display = (term === '' || rowText.includes(term)) ? '' : 'none';
                }
            });
    </script>
</body>
</html>