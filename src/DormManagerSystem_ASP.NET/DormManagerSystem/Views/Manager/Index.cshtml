@model IEnumerable<DormWeb.Models.AnnouncementItem>
@{
    ViewData["Title"] = "داشبورد مدیر";
    Layout = null;
    var stats = ViewBag.Stats as DormWeb.Models.DashboardStats;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>داشبورد | پنل مدیر</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: Tahoma, sans-serif;
                background: #f4f6f9;
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem;
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem;
            }

            .user-details strong {
                font-size: .95rem;
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px);
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem;
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333;
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s;
                }

                    .sidebar a:hover {
                        background: #0056b3;
                    }

            .main {
                flex: 1;
                padding: 2rem;
            }

            .stats-row {
                display: flex;
                gap: 1.5rem;
                margin-bottom: 2rem;
            }

            .stat-card {
                flex: 1;
                padding: 1.5rem;
                border-radius: 12px;
                color: white;
                text-align: center;
                cursor: pointer;
                transition: transform .2s;
                text-decoration: none;
            }

                .stat-card:hover {
                    transform: scale(1.03);
                }

                .stat-card.blue {
                    background: linear-gradient(135deg, #4facfe, #00f2fe);
                }

                .stat-card.green {
                    background: linear-gradient(135deg, #43e97b, #38f9d7);
                }

                .stat-card.purple {
                    background: linear-gradient(135deg, #a18cd1, #fbc2eb);
                }

            .stat-number {
                font-size: 2.5rem;
                font-weight: bold;
            }

            .stat-label {
                font-size: 1rem;
                opacity: 0.9;
                margin-top: .5rem;
            }

            .announce-card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1rem;
            }

            .announce-item {
                padding: .75rem;
                border-bottom: 1px solid #eee;
            }

                .announce-item:last-child {
                    border-bottom: none;
                }

            .announce-title {
                font-weight: bold;
                color: #333;
            }

            .announce-date {
                font-size: .8rem;
                color: #888;
            }

            .no-data {
                text-align: center;
                padding: 2rem;
                color: #888;
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details">
                <strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong>
                <small>کد پرسنلی: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل مدیر</h2>
            <a href="/Manager/Index" style="background:#0056b3;"> داشبورد</a>
            <a href="/Manager/Students"> دانشجویان</a>
            <a href="/Manager/ReserveRoom"> رزرو اتاق</a>
            <a href="/Manager/Dormitories"> خوابگاه‌ها</a>
            <a href="/Manager/Blocks"> بلوک‌ها</a>
            <a href="/Manager/Rooms"> اتاق‌ها</a>
            <a href="/Manager/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Manager/Staffs"> کارکنان</a>
            <a href="/Manager/Profile"> پروفایل</a>
            <a href="/Manager/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            <h2>داشبورد</h2>

            <div class="stats-row">
                <a href="/Manager/Students" class="stat-card blue">
                    <div class="stat-number">@(stats?.TotalStudents ?? 0)</div>
                    <div class="stat-label">دانشجویان</div>
                </a>
                <a href="/Manager/Blocks" class="stat-card green">
                    <div class="stat-number">@(stats?.TotalBlocks ?? 0)</div>
                    <div class="stat-label">بلوک‌ها</div>
                </a>
                <a href="/Manager/Dormitories" class="stat-card purple">
                    <div class="stat-number">@(stats?.TotalDormitories ?? 0)</div>
                    <div class="stat-label">خوابگاه‌ها</div>
                </a>
            </div>

            <div class="announce-card">
                <h3>آخرین اطلاعیه‌ها</h3>
                @if (Model != null && Model.Any())
                {
                    @foreach (var a in Model)
                    {
                        <div class="announce-item">
                            <div class="announce-title">@a.Title</div>
                            <div class="announce-date">@a.Date.ToString("yyyy/MM/dd") | انقضا: @a.EXPDate.ToString("yyyy/MM/dd")</div>
                            <p>@a.Description</p>
                        </div>
                    }
                }
                else
                {
                    <div class="no-data">هیچ اطلاعیه‌ای وجود ندارد.</div>
                }
            </div>
        </div>
    </div>
</body>
</html>