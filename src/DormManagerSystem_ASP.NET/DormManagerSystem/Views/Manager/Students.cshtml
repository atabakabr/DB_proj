@model IEnumerable<DormWeb.Models.StudentListItem>
@{
    ViewData["Title"] = "دانشجویان";
    Layout = null;
    var prevDisabled = (int)ViewBag.Page <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = (int)ViewBag.Page >= (int)ViewBag.TotalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دانشجویان | پنل مدیر</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: Tahoma, sans-serif;
                background: #f4f6f9;
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem;
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem;
            }

            .user-details strong {
                font-size: .95rem;
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px);
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem;
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333;
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s;
                }

                    .sidebar a:hover {
                        background: #0056b3;
                    }

            .main {
                flex: 1;
                padding: 2rem;
            }

            .list-card {
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1rem;
            }

            .search-box {
                margin-bottom: 1rem;
                display: flex;
                gap: 0.5rem;
            }

                .search-box input {
                    flex: 1;
                    max-width: 400px;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    font-family: inherit;
                }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .btn-primary {
                background: #007bff;
                color: white;
            }

            .btn-secondary {
                background: #6c757d;
                color: white;
            }

            .btn-success {
                background: #28a745;
                color: white;
            }

            .btn-warning {
                background: #ffc107;
                color: #333;
            }

            .btn-danger {
                background: #dc3545;
                color: white;
            }

            .table-container {
                overflow-y: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

            th {
                background: #f8f8f8;
                font-weight: bold;
            }

            .pagination {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: .5rem;
                margin-top: 1rem;
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333;
                    background: white;
                }

                    .pagination a:hover {
                        background: #007bff;
                        color: white;
                    }

                .pagination .current {
                    background: #007bff;
                    color: white;
                }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details">
                <strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong>
                <small>کد پرسنلی: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل مدیر</h2>
            <a href="/Manager/Index"> داشبورد</a>
            <a href="/Manager/Students" style="background:#0056b3;"> دانشجویان</a>
            <a href="/Manager/ReserveRoom"> رزرو اتاق</a>
            <a href="/Manager/Dormitories"> خوابگاه‌ها</a>
            <a href="/Manager/Blocks"> بلوک‌ها</a>
            <a href="/Manager/Rooms"> اتاق‌ها</a>
            <a href="/Manager/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Manager/Staffs"> کارکنان</a>
            <a href="/Manager/Profile"> پروفایل</a>
            <a href="/Manager/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <h2>دانشجویان</h2>
                <a href="/Manager/AddStudent" class="btn btn-success">➕ افزودن دانشجو</a>
            </div>
            <div class="list-card">
                <form method="get" class="search-box">
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="نام یا شماره دانشجویی...">
                    <button type="submit" class="btn btn-primary">جستجو</button>
                    <a href="/Manager/Students" class="btn btn-secondary">پاک کردن</a>
                </form>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>کد</th>
                                <th>نام</th>
                                <th>کد ملی</th>
                                <th>موبایل</th>
                                <th>رشته</th>
                                <th>گروه</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var s in Model)
                                {
                                    <tr>
                                        <td>@s.StudentID</td>
                                        <td>@s.FirstName @s.LastName</td>
                                        <td>@s.NationalID</td>
                                        <td>@s.MobilePhoneNumber</td>
                                        <td>@s.Major</td>
                                        <td>@s.GroupNumber</td>
                                        <td>
                                            <a href="/Manager/EditStudent/@s.StudentID" class="btn btn-warning btn-sm">✏️</a>
                                            <form method="post" action="/Manager/DeleteStudent" style="display:inline" onsubmit="return confirm('حذف شود؟')">
                                                <input type="hidden" name="id" value="@s.StudentID">
                                                <button class="btn btn-danger btn-sm">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" style="text-align:center; padding:2rem; color:#888;">دانشجویی یافت نشد.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Manager/Students?search=@ViewBag.Search&page=@(ViewBag.Page - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.Page)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Manager/Students?search=@ViewBag.Search&page=@i">@i</a>
                            }
                        }
                        <a href="/Manager/Students?search=@ViewBag.Search&page=@(ViewBag.Page + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center; margin-top:.5rem; color:#888;">نمایش  @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>
</body>
</html>