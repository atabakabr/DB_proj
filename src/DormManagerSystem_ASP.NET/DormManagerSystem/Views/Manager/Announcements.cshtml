@model IEnumerable<DormWeb.Models.AnnouncementItem>
@{
    ViewData["Title"] = "اطلاعیه‌ها";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>اطلاعیه‌ها | پنل مدیر</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold
            }

            .user-details small {
                display: block;
                color: #666
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    color: #333;
                    margin-bottom: .5rem
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center
                }

                    .sidebar a:hover {
                        background: #0056b3
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem;
                margin-bottom: 1.5rem
            }

            .tabs {
                display: flex;
                gap: 0;
                margin-bottom: 1rem
            }

            .tab-btn {
                padding: .5rem 1.5rem;
                border: 1px solid #ddd;
                background: #f8f9fa;
                cursor: pointer;
                font-weight: bold;
                border-radius: 6px 6px 0 0
            }

                .tab-btn.active {
                    background: #007bff;
                    color: white;
                    border-color: #007bff
                }

            .tab-content {
                display: none
            }

                .tab-content.active {
                    display: block
                }

            .form-row {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
                align-items: flex-end
            }

            .form-group {
                flex: 1 1 200px
            }

                .form-group label {
                    font-weight: bold;
                    display: block;
                    margin-bottom: .3rem
                }

                .form-group input, .form-group select, .form-group textarea {
                    width: 100%;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px
                }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold
            }

            .btn-primary {
                background: #007bff;
                color: white
            }

            .btn-success {
                background: #28a745;
                color: white
            }

            .btn-danger {
                background: #dc3545;
                color: white
            }

            .student-result {
                margin-top: .5rem;
                padding: .5rem;
                background: #e7f3ff;
                border-radius: 4px
            }

            table {
                width: 100%;
                border-collapse: collapse
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right
            }

            th {
                background: #f8f8f8
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details"><strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong><small>کد: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل مدیر</h2>
            <a href="/Manager/Index"> داشبورد</a>
            <a href="/Manager/Students"> دانشجویان</a>
            <a href="/Manager/ReserveRoom"> رزرو اتاق</a>
            <a href="/Manager/Dormitories"> خوابگاه‌ها</a>
            <a href="/Manager/Blocks"> بلوک‌ها</a>
            <a href="/Manager/Rooms"> اتاق‌ها</a>
            <a href="/Manager/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Manager/Staffs"> کارکنان</a>
            <a href="/Manager/Profile"> پروفایل</a>
            <a href="/Manager/Announcements" style="background:#0056b3;"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            @if (TempData["Msg"] != null)
            {
                <div style="background:#d4edda;color:#155724;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Msg"]</div>
            }
            @if (TempData["Err"] != null)
            {
                <div style="background:#f8d7da;color:#721c24;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Err"]</div>
            }

            <div class="card">
                <h3>➕ اطلاعیه جدید</h3>

                <div class="tabs">
                    <button type="button" class="tab-btn active" onclick="switchTab(this, 'dormblock')">🏢 خوابگاه / بلوک</button>
                    <button type="button" class="tab-btn" onclick="switchTab(this, 'student')">👤 دانشجو</button>
                </div>

                <form method="post" action="/Manager/AddAnnouncement">
                    <input type="hidden" name="TargetType" id="mainTargetType" value="Dormitory">
                    <input type="hidden" name="StudentID" id="studentIdHidden">

                    <div id="tab-dormblock" class="tab-content active">
                        <div class="form-row">
                            <div class="form-group">
                                <label>نوع مخاطب</label>
                                <select id="dormblockSelect" onchange="toggleDormBlock()">
                                    <option value="Dormitory">خوابگاه</option>
                                    <option value="Block">بلوک</option>
                                </select>
                            </div>
                            <div class="form-group" id="dormSelect">
                                <label>خوابگاه</label>
                                <select name="DormID">
                                    <option value="">انتخاب کنید...</option>
                                    @foreach (var d in (ViewBag.Dormitories as IEnumerable<DormWeb.Models.DormitoryItem>) ?? new List<DormWeb.Models.DormitoryItem>())
                                    {
                                        <option value="@d.DormID">@d.DormitoryName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group" id="blockSelect" style="display:none">
                                <label>بلوک</label>
                                <select name="BlockID">
                                    <option value="">انتخاب کنید...</option>
                                    @foreach (var b in (ViewBag.Blocks as IEnumerable<DormWeb.Models.BlockItem>) ?? new List<DormWeb.Models.BlockItem>())
                                    {
                                        <option value="@b.BlockID">@b.BName (@b.DormitoryName)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div id="tab-student" class="tab-content">
                        <div class="form-row">
                            <div class="form-group">
                                <label>شماره دانشجویی</label>
                                <div style="display:flex;gap:.5rem">
                                    <input type="number" id="studentSearch" placeholder="مثال: ۴۰۰۰۰۰۰۰۱" style="flex:1">
                                    <button type="button" class="btn btn-primary" onclick="searchStudent()">🔍 بررسی</button>
                                </div>
                            </div>
                        </div>
                        <div id="studentResult" class="student-result" style="display:none"></div>
                    </div>

                    <div class="form-row" style="margin-top:1rem">
                        <div class="form-group"><label>عنوان</label><input type="text" name="Title" required></div>
                        <div class="form-group"><label>روش ارسال</label><select name="DeliveryMethod"><option value="SM">پیامک</option><option value="EM">ایمیل</option><option value="SY">سیستمی</option></select></div>
                        <div class="form-group"><label>تاریخ انقضا</label><input type="date" name="EXPDate" required></div>
                    </div>
                    <div class="form-row"><div class="form-group"><label>توضیحات</label><textarea name="Description" rows="2"></textarea></div></div>
                    <button type="submit" class="btn btn-success" style="margin-top:1rem">📨 ارسال اطلاعیه</button>
                </form>
            </div>

            <div class="card">
                <h3>📋 اطلاعیه‌های قبلی</h3>
                <table>
                    <thead>
                        <tr>
                            <th>کد</th>
                            <th>عنوان</th>
                            <th>تاریخ</th>
                            <th>انقضا</th>
                            <th>روش</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td>@a.AnnouncementID</td>
                                    <td>@a.Title</td>
                                    <td>@a.Date.ToString("yyyy/MM/dd")</td>
                                    <td>@a.EXPDate.ToString("yyyy/MM/dd")</td>
                                    <td>@a.DeliveryMethod</td>
                                    <td style="text-align:center">
                                        <form method="post" action="/Manager/DeleteAnnouncement" onsubmit="return confirm('آیا از حذف این اطلاعیه مطمئن هستید؟')">
                                            <input type="hidden" name="id" value="@a.AnnouncementID">
                                            <button type="submit" class="btn btn-danger" style="padding:.3rem .6rem; font-size:.9rem">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="text-align:center;padding:2rem">اطلاعیه‌ای وجود ندارد.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script>
            function switchTab(btn, tab) {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

                btn.classList.add('active');
                document.getElementById('tab-' + tab).classList.add('active');

                const mainTarget = document.getElementById('mainTargetType');
                if (tab === 'dormblock') {
                    mainTarget.value = document.getElementById('dormblockSelect').value;
                } else if (tab === 'student') {
                    mainTarget.value = 'Student';
                }
            }

            function toggleDormBlock() {
                const val = document.getElementById('dormblockSelect').value;
                document.getElementById('dormSelect').style.display = val === 'Dormitory' ? 'block' : 'none';
                document.getElementById('blockSelect').style.display = val === 'Block' ? 'block' : 'none';
                document.getElementById('mainTargetType').value = val;
            }

            async function searchStudent() {
                const id = document.getElementById('studentSearch').value;
                if (!id) return;
                const res = await fetch('/Manager/SearchStudent?studentId=' + id);
                const data = await res.json();
                const div = document.getElementById('studentResult');
                if (data.found) {
                    div.style.display = 'block';
                    div.innerHTML = '✅ ' + data.name + ' (شماره: ' + id + ')';
                    document.getElementById('studentIdHidden').value = id;
                } else {
                    div.style.display = 'block';
                    div.innerHTML = '❌ دانشجو یافت نشد.';
                    document.getElementById('studentIdHidden').value = '';
                }
            }
    </script>
</body>
</html>