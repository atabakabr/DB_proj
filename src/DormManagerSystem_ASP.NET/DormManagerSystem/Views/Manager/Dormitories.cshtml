@model IEnumerable<DormWeb.Models.DormitoryItem>
@{
    ViewData["Title"] = "خوابگاه‌ها";
    Layout = null;
    var prevDisabled = (int)ViewBag.Page <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = (int)ViewBag.Page >= (int)ViewBag.TotalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>خوابگاه‌ها | پنل مدیر</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: Tahoma, sans-serif;
                background: #f4f6f9;
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem;
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem;
            }

            .user-details strong {
                font-size: .95rem;
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px);
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem;
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333;
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s;
                }

                    .sidebar a:hover {
                        background: #0056b3;
                    }

            .main {
                flex: 1;
                padding: 2rem;
            }

            .list-card {
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1rem;
            }

            .search-box {
                margin-bottom: 1rem;
                display: flex;
                gap: 0.5rem;
            }

                .search-box input {
                    flex: 1;
                    max-width: 400px;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
                font-weight: bold;
            }

            .btn-primary {
                background: #007bff;
                color: white;
            }

            .btn-secondary {
                background: #6c757d;
                color: white;
            }

            .btn-success {
                background: #28a745;
                color: white;
            }

            .btn-warning {
                background: #ffc107;
                color: #333;
            }

            .btn-danger {
                background: #dc3545;
                color: white;
            }

            .table-container {
                overflow-y: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

            th {
                background: #f8f8f8;
                font-weight: bold;
            }

            .pagination {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: .5rem;
                margin-top: 1rem;
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333;
                    background: white;
                }

                    .pagination a:hover {
                        background: #007bff;
                        color: white;
                    }

                .pagination .current {
                    background: #007bff;
                    color: white;
                }

            .modal-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 1000;
                justify-content: center;
                align-items: center;
            }

            .modal {
                background: white;
                border-radius: 12px;
                padding: 2rem;
                max-width: 600px;
                width: 90%;
                max-height: 80vh;
                overflow-y: auto;
            }

                .modal h3 {
                    margin-bottom: 1rem;
                }

                .modal .field-group {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 1rem;
                    margin-bottom: 1rem;
                }

                .modal .field {
                    flex: 1 1 250px;
                }

                    .modal .field label {
                        display: block;
                        font-weight: bold;
                        margin-bottom: .3rem;
                    }

                    .modal .field input, .modal .field select {
                        width: 100%;
                        padding: .5rem;
                        border: 1px solid #ccc;
                        border-radius: 4px;
                    }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details">
                <strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong>
                <small>کد پرسنلی: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل مدیر</h2>
            <a href="/Manager/Index"> داشبورد</a>
            <a href="/Manager/Students"> دانشجویان</a>
            <a href="/Manager/ReserveRoom"> رزرو اتاق</a>
            <a href="/Manager/Dormitories" style="background:#0056b3;"> خوابگاه‌ها</a>
            <a href="/Manager/Blocks"> بلوک‌ها</a>
            <a href="/Manager/Rooms"> اتاق‌ها</a>
            <a href="/Manager/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Manager/Staffs"> کارکنان</a>
            <a href="/Manager/Profile"> پروفایل</a>
            <a href="/Manager/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <h2>خوابگاه‌ها</h2>
                <button class="btn btn-success" onclick="openAddModal()">➕ افزودن خوابگاه</button>
            </div>
            <div class="list-card">
                <form method="get" class="search-box">
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="جستجوی نام، شهر، یا استان...">
                    <button type="submit" class="btn btn-primary">جستجو</button>
                    <a href="/Manager/Dormitories" class="btn btn-secondary">پاک کردن</a>
                </form>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>کد</th>
                                <th>نام</th>
                                <th>شهر</th>
                                <th>استان</th>
                                <th>نوع</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var d in Model)
                                {
                                    <tr>
                                        <td>@d.DormID</td>
                                        <td>@d.DormitoryName</td>
                                        <td>@d.City</td>
                                        <td>@d.Province</td>
                                        <td>
                                            @if (d.DormitoryType.Trim() == "M")
                                            {
                                                <span>پسرانه</span>
                                            }
                                            else if (d.DormitoryType.Trim() == "F")
                                            {
                                                <span>دخترانه</span>
                                            }
                                            else
                                            {
                                                <span>متاهلی</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-warning btn-sm" onclick="openEditModal(@d.DormID, '@d.DormitoryName', '@d.City', '@d.Province', '@d.DormitoryType', '@d.PostID', '@d.AddressDescription')">✏️</button>
                                            <form method="post" action="/Manager/DeleteDormitory" style="display:inline" onsubmit="return confirm('حذف شود؟')">
                                                <input type="hidden" name="id" value="@d.DormID">
                                                <button class="btn btn-danger btn-sm">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" style="text-align:center; padding:2rem; color:#888;">خوابگاهی یافت نشد.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Manager/Dormitories?search=@ViewBag.Search&page=@(ViewBag.Page - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.Page)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Manager/Dormitories?search=@ViewBag.Search&page=@i">@i</a>
                            }
                        }
                        <a href="/Manager/Dormitories?search=@ViewBag.Search&page=@(ViewBag.Page + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center; margin-top:.5rem; color:#888;">نمایش @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="addModal">
        <div class="modal">
            <h3>افزودن خوابگاه</h3>
            <form method="post" action="/Manager/AddDormitory">
                <div class="field-group">
                    <div class="field"><label>نام</label><input type="text" name="DormitoryName" required></div>
                    <div class="field"><label>شهر</label><input type="text" name="City" required></div>
                    <div class="field"><label>استان</label><input type="text" name="Province" required></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>نوع</label><select name="DormitoryType"><option value="M">پسرانه</option><option value="F">دخترانه</option><option value="Married">متاهلی</option></select></div>
                    <div class="field"><label>کد پستی</label><input type="text" name="PostID" required></div>
                    <div class="field"><label>آدرس</label><input type="text" name="AddressDescription"></div>
                </div>
                <button type="submit" class="btn btn-success">ذخیره</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">انصراف</button>
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="editModal">
        <div class="modal">
            <h3>ویرایش خوابگاه</h3>
            <form method="post" action="/Manager/EditDormitory">
                <input type="hidden" name="DormID" id="editDormID">
                <div class="field-group">
                    <div class="field"><label>نام</label><input type="text" name="DormitoryName" id="editName" required></div>
                    <div class="field"><label>شهر</label><input type="text" name="City" id="editCity" required></div>
                    <div class="field"><label>استان</label><input type="text" name="Province" id="editProvince" required></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>نوع</label><select name="DormitoryType" id="editType"><option value="M">پسرانه</option><option value="F">دخترانه</option><option value="Married">متاهلی</option></select></div>
                    <div class="field"><label>کد پستی</label><input type="text" name="PostID" id="editPostID" required></div>
                    <div class="field"><label>آدرس</label><input type="text" name="AddressDescription" id="editAddress"></div>
                </div>
                <button type="submit" class="btn btn-warning">ذخیره</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">انصراف</button>
            </form>
        </div>
    </div>

    <script>
            function openAddModal() { document.getElementById('addModal').style.display = 'flex'; }
            function closeModal(id) { document.getElementById(id).style.display = 'none'; }

            function openEditModal(id, name, city, province, type, postid, address) {
                document.getElementById('editDormID').value = id;
                document.getElementById('editName').value = name;
                document.getElementById('editCity').value = city;
                document.getElementById('editProvince').value = province;
                document.getElementById('editType').value = type;
                document.getElementById('editPostID').value = postid;
                document.getElementById('editAddress').value = address || '';
                document.getElementById('editModal').style.display = 'flex';
            }

            window.onclick = function(event) {
                if (event.target.classList.contains('modal-overlay')) event.target.style.display = 'none';
            }
    </script>
</body>
</html>