@model IEnumerable<DormWeb.Models.TimeSlotItem>
@{
    ViewData["Title"] = "بازه‌های رزرو";
    Layout = null;
    var prevDisabled = (int)ViewBag.Page <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = (int)ViewBag.Page >= (int)ViewBag.TotalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بازه‌های رزرو | پنل مدیر</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: Tahoma, sans-serif;
                background: #f4f6f9;
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem;
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem;
            }

            .user-details strong {
                font-size: .95rem;
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px);
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem;
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333;
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s;
                }

                    .sidebar a:hover {
                        background: #0056b3;
                    }

            .main {
                flex: 1;
                padding: 2rem;
            }

            .list-card {
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1rem;
            }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
                font-weight: bold;
            }

            .btn-primary {
                background: #007bff;
                color: white;
            }

            .btn-secondary {
                background: #6c757d;
                color: white;
            }

            .btn-success {
                background: #28a745;
                color: white;
            }

            .btn-warning {
                background: #ffc107;
                color: #333;
            }

            .btn-danger {
                background: #dc3545;
                color: white;
            }

            .table-container {
                overflow-y: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

            th {
                background: #f8f8f8;
                font-weight: bold;
            }

            .pagination {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: .5rem;
                margin-top: 1rem;
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333;
                    background: white;
                }

                    .pagination a:hover {
                        background: #007bff;
                        color: white;
                    }

                .pagination .current {
                    background: #007bff;
                    color: white;
                }

            .modal-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 1000;
                justify-content: center;
                align-items: center;
            }

            .modal {
                background: white;
                border-radius: 12px;
                padding: 2rem;
                max-width: 650px;
                width: 90%;
            }

                .modal h3 {
                    margin-bottom: 1rem;
                }

                .modal .field-group {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 1rem;
                    margin-bottom: 1rem;
                }

                .modal .field {
                    flex: 1 1 250px;
                }

                    .modal .field label {
                        display: block;
                        font-weight: bold;
                        margin-bottom: .3rem;
                    }

                    .modal .field input, .modal .field select {
                        width: 100%;
                        padding: .5rem;
                        border: 1px solid #ccc;
                        border-radius: 4px;
                    }

            .badge-active {
                background: #d4edda;
                color: #155724;
                padding: .2rem .6rem;
                border-radius: 20px;
                font-size: .8rem;
            }

            .badge-inactive {
                background: #f8d7da;
                color: #721c24;
                padding: .2rem .6rem;
                border-radius: 20px;
                font-size: .8rem;
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details">
                <strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong>
                <small>کد پرسنلی: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل مدیر</h2>
            <a href="/Manager/Index"> داشبورد</a>
            <a href="/Manager/Students"> دانشجویان</a>
            <a href="/Manager/ReserveRoom"> رزرو اتاق</a>
            <a href="/Manager/Dormitories"> خوابگاه‌ها</a>
            <a href="/Manager/Blocks"> بلوک‌ها</a>
            <a href="/Manager/Rooms"> اتاق‌ها</a>
            <a href="/Manager/TimeSlots" style="background:#0056b3;"> بازه‌های رزرو</a>
            <a href="/Manager/Staffs"> کارکنان</a>
            <a href="/Manager/Profile"> پروفایل</a>
            <a href="/Manager/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <h2>بازه‌های رزرو</h2>
                <button class="btn btn-success" onclick="openAddModal()">➕ افزودن بازه</button>
            </div>
            <div class="list-card">
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>کد</th>
                                <th>بلوک</th>
                                <th>شروع ثبت‌نام</th>
                                <th>شروع انتخاب</th>
                                <th>پایان انتخاب</th>
                                <th>شهریه</th>
                                <th>وضعیت</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var t in Model)
                                {
                                    <tr>
                                        <td>@t.TID</td>
                                        <td>@t.BlockName</td>
                                        <td>@t.GroupingStartDate.ToString("yyyy/MM/dd")</td>
                                        <td>@t.SelectionStartDate.ToString("yyyy/MM/dd")</td>
                                        <td>@t.SelectionEndDate.ToString("yyyy/MM/dd")</td>
                                        <td>@t.Tuition.ToString("N0")</td>
                                        <td><span class="@(t.IsActive ? "badge-active" : "badge-inactive")">@(t.IsActive ? "فعال" : "غیرفعال")</span></td>
                                        <td>
                                            <form method="post" action="/Manager/ToggleTimeSlot" style="display:inline">
                                                <input type="hidden" name="id" value="@t.TID">
                                                <button class="btn btn-warning btn-sm">@(t.IsActive ? "غیرفعال" : "فعال")</button>
                                            </form>
                                            <form method="post" action="/Manager/DeleteTimeSlot" style="display:inline" onsubmit="return confirm('حذف شود؟')">
                                                <input type="hidden" name="id" value="@t.TID">
                                                <button class="btn btn-danger btn-sm">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="8" style="text-align:center; padding:2rem; color:#888;">بازه‌ای یافت نشد.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Manager/TimeSlots?page=@(ViewBag.Page - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.Page)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Manager/TimeSlots?page=@i">@i</a>
                            }
                        }
                        <a href="/Manager/TimeSlots?page=@(ViewBag.Page + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center; margin-top:.5rem; color:#888;">نمایش  @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="addModal">
        <div class="modal">
            <h3>افزودن بازه رزرو</h3>
            <form method="post" action="/Manager/AddTimeSlot">
                <div class="field-group">
                    <div class="field">
                        <label>بلوک</label>
                        <select name="BlockID" required>
                            <option value="">انتخاب کنید...</option>
                            @foreach (var b in ViewBag.Blocks as IEnumerable<DormWeb.Models.BlockItem>)
                            {
                                <option value="@b.BlockID">@b.BName (@b.DormitoryName)</option>
                            }
                        </select>
                    </div>
                    <div class="field"><label>تاریخ شروع ثبت‌نام</label><input type="date" name="GroupingStartDate" required></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>تاریخ شروع انتخاب</label><input type="date" name="SelectionStartDate" required></div>
                    <div class="field"><label>تاریخ پایان انتخاب</label><input type="date" name="SelectionEndDate" required></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>شهریه (تومان)</label><input type="number" name="Tuition" required></div>
                </div>
                <button type="submit" class="btn btn-success">ذخیره</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">انصراف</button>
            </form>
        </div>
    </div>

    <script>
            function openAddModal() { document.getElementById('addModal').style.display = 'flex'; }
            function closeModal(id) { document.getElementById(id).style.display = 'none'; }
            window.onclick = function(event) { if (event.target.classList.contains('modal-overlay')) event.target.style.display = 'none'; }
    </script>
</body>
</html>