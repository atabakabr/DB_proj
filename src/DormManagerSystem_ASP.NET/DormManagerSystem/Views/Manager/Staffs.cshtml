@model IEnumerable<DormWeb.Models.StaffItem>
@{
    ViewData["Title"] = "کارکنان";
    Layout = null;
    var prevDisabled = (int)ViewBag.Page <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = (int)ViewBag.Page >= (int)ViewBag.TotalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>کارکنان | پنل مدیر</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: Tahoma, sans-serif;
                background: #f4f6f9;
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #007bff;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.1rem;
            }

            .user-details small {
                display: block;
                color: #666;
                font-size: .75rem;
            }

            .user-details strong {
                font-size: .95rem;
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px);
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem;
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    margin-bottom: .5rem;
                    color: #333;
                }

                .sidebar a {
                    display: block;
                    background: #007bff;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s;
                }

                    .sidebar a:hover {
                        background: #0056b3;
                    }

            .main {
                flex: 1;
                padding: 2rem;
            }

            .list-card {
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1rem;
            }

            .search-box {
                margin-bottom: 1rem;
                display: flex;
                gap: 0.5rem;
            }

                .search-box input {
                    flex: 1;
                    max-width: 400px;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
                font-weight: bold;
            }

            .btn-primary {
                background: #007bff;
                color: white;
            }

            .btn-secondary {
                background: #6c757d;
                color: white;
            }

            .btn-success {
                background: #28a745;
                color: white;
            }

            .btn-warning {
                background: #ffc107;
                color: #333;
            }

            .btn-danger {
                background: #dc3545;
                color: white;
            }

            .table-container {
                overflow-y: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

            th {
                background: #f8f8f8;
                font-weight: bold;
            }

            .pagination {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: .5rem;
                margin-top: 1rem;
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333;
                    background: white;
                }

                    .pagination a:hover {
                        background: #007bff;
                        color: white;
                    }

                .pagination .current {
                    background: #007bff;
                    color: white;
                }

            .modal-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 1000;
                justify-content: center;
                align-items: center;
            }

            .modal {
                background: white;
                border-radius: 12px;
                padding: 2rem;
                max-width: 650px;
                width: 90%;
                max-height: 80vh;
                overflow-y: auto;
            }

                .modal h3 {
                    margin-bottom: 1rem;
                }

                .modal .field-group {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 1rem;
                    margin-bottom: 1rem;
                }

                .modal .field {
                    flex: 1 1 250px;
                }

                    .modal .field label {
                        display: block;
                        font-weight: bold;
                        margin-bottom: .3rem;
                    }

                    .modal .field input, .modal .field select {
                        width: 100%;
                        padding: .5rem;
                        border: 1px solid #ccc;
                        border-radius: 4px;
                    }

            .block-checkbox-group {
                border: 1px solid #ccc;
                border-radius: 4px;
                padding: .5rem;
                max-height: 120px;
                overflow-y: auto;
                display: flex;
                flex-wrap: wrap;
                gap: .5rem;
            }

                .block-checkbox-group label {
                    display: flex;
                    align-items: center;
                    gap: .25rem;
                    font-weight: normal;
                    font-size: .85rem;
                }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@ViewBag.GuardFirstName?.ToString()?.Substring(0, 1)</div>
            <div class="user-details">
                <strong>@ViewBag.GuardFirstName @ViewBag.GuardLastName</strong>
                <small>کد پرسنلی: @ViewBag.GuardPersonnelID | @ViewBag.GuardRole</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل مدیر</h2>
            <a href="/Manager/Index"> داشبورد</a>
            <a href="/Manager/Students"> دانشجویان</a>
            <a href="/Manager/ReserveRoom"> رزرو اتاق</a>
            <a href="/Manager/Dormitories"> خوابگاه‌ها</a>
            <a href="/Manager/Blocks"> بلوک‌ها</a>
            <a href="/Manager/Rooms"> اتاق‌ها</a>
            <a href="/Manager/TimeSlots"> بازه‌های رزرو</a>
            <a href="/Manager/Staffs" style="background:#0056b3;"> کارکنان</a>
            <a href="/Manager/Profile"> پروفایل</a>
            <a href="/Manager/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <h2>کارکنان</h2>
                <button class="btn btn-success" onclick="openAddModal()">➕ افزودن کارمند</button>
            </div>
            <div class="list-card">
                <form method="get" class="search-box">
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="جستجوی نام یا شماره پرسنلی...">
                    <button type="submit" class="btn btn-primary">جستجو</button>
                    <a href="/Manager/Staffs" class="btn btn-secondary">پاک کردن</a>
                </form>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr><th>کد</th><th>نام</th><th>نقش</th><th>موبایل</th><th>ایمیل</th><th>شیفت</th><th></th></tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var s in Model)
                                {
                                    <tr>
                                        <td>@s.PersonnelID</td>
                                        <td>@s.FirstName @s.LastName</td>
                                        <td>@s.UserRole</td>
                                        <td>@s.MobilePhoneNumber</td>
                                        <td>@s.OrganizationalEmail</td>
                                        <td>@s.WorkShift</td>
                                        <td>
                                            <button class="btn btn-warning btn-sm" onclick="openEditModal(@s.PersonnelID, '@s.FirstName', '@s.LastName', '@s.NationalID', '@s.Gender', '@s.MobilePhoneNumber', '@s.OrganizationalEmail', '@s.UserRole', '@s.WorkShift', '@s.Workplace')">✏️</button>
                                            <form method="post" action="/Manager/DeleteStaff" style="display:inline" onsubmit="return confirm('حذف شود؟')">
                                                <input type="hidden" name="id" value="@s.PersonnelID">
                                                <button class="btn btn-danger btn-sm">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" style="text-align:center; padding:2rem; color:#888;">کارمندی یافت نشد.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Manager/Staffs?search=@ViewBag.Search&page=@(ViewBag.Page - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.Page)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Manager/Staffs?search=@ViewBag.Search&page=@i">@i</a>
                            }
                        }
                        <a href="/Manager/Staffs?search=@ViewBag.Search&page=@(ViewBag.Page + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center; margin-top:.5rem; color:#888;">نمایش @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="addModal">
        <div class="modal">
            <h3>افزودن کارمند</h3>
            <form method="post" action="/Manager/AddStaff">
                <div class="field-group">
                    <div class="field"><label>کد پرسنلی</label><input type="number" name="PersonnelID" required></div>
                    <div class="field"><label>نام</label><input type="text" name="FirstName" required></div>
                    <div class="field"><label>نام خانوادگی</label><input type="text" name="LastName" required></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>کد ملی</label><input type="text" name="NationalID" required></div>
                    <div class="field"><label>جنسیت</label><select name="Gender"><option value="M">مرد</option><option value="F">زن</option></select></div>
                    <div class="field"><label>موبایل</label><input type="text" name="MobilePhoneNumber" required></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>ایمیل</label><input type="email" name="OrganizationalEmail"></div>
                    <div class="field"><label>نقش</label><select name="UserRole" id="addRoleSelect"><option value="مدیر">مدیر</option><option value="سرپرست">سرپرست</option><option value="نگهبان">نگهبان</option></select></div>
                    <div class="field"><label>شیفت</label><select name="WorkShift"><option value="روزانه">روزانه</option><option value="شبانه">شبانه</option></select></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>رمز عبور</label><input type="text" name="Password" placeholder="پیش‌فرض: pass123"></div>
                    <div class="field"><label>محل کار</label><input type="text" name="Workplace"></div>
                </div>
                <div class="field-group" id="addBlockSection" style="display:none;">
                    <div class="field" style="flex:1 1 100%;">
                        <label>بلوک‌های تحت نظارت</label>
                        <div class="block-checkbox-group">
                            @foreach (var b in (ViewBag.AllBlocks as IEnumerable<DormWeb.Models.BlockItem>) ?? new List<DormWeb.Models.BlockItem>())
                            {
                                <label><input type="checkbox" name="BlockIDs" value="@b.BlockID"> @b.BName (@b.DormitoryName)</label>
                            }
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-success">ذخیره</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">انصراف</button>
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="editModal">
        <div class="modal">
            <h3>ویرایش کارمند</h3>
            <form method="post" action="/Manager/EditStaff">
                <input type="hidden" name="PersonnelID" id="editPID">
                <div class="field-group">
                    <div class="field"><label>نام</label><input type="text" name="FirstName" id="editFName" required></div>
                    <div class="field"><label>نام خانوادگی</label><input type="text" name="LastName" id="editLName" required></div>
                    <div class="field"><label>کد ملی</label><input type="text" name="NationalID" id="editNID" required></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>جنسیت</label><select name="Gender" id="editGender"><option value="M">مرد</option><option value="F">زن</option></select></div>
                    <div class="field"><label>موبایل</label><input type="text" name="MobilePhoneNumber" id="editMobile" required></div>
                    <div class="field"><label>ایمیل</label><input type="email" name="OrganizationalEmail" id="editEmail"></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>نقش</label><select name="UserRole" id="editRoleSelect"><option value="مدیر">مدیر</option><option value="سرپرست">سرپرست</option><option value="نگهبان">نگهبان</option></select></div>
                    <div class="field"><label>شیفت</label><select name="WorkShift" id="editShift"><option value="روزانه">روزانه</option><option value="شبانه">شبانه</option></select></div>
                    <div class="field"><label>محل کار</label><input type="text" name="Workplace" id="editWorkplace"></div>
                </div>
                <div class="field-group">
                    <div class="field"><label>رمز عبور جدید (در صورت تغییر)</label><input type="text" name="Password" placeholder="در صورت عدم تغییر، خالی بگذارید"></div>
                </div>
                <div class="field-group" id="editBlockSection" style="display:none;">
                    <div class="field" style="flex:1 1 100%;">
                        <label>بلوک‌های تحت نظارت</label>
                        <div class="block-checkbox-group">
                            @foreach (var b in (ViewBag.AllBlocks as IEnumerable<DormWeb.Models.BlockItem>) ?? new List<DormWeb.Models.BlockItem>())
                            {
                                <label><input type="checkbox" name="BlockIDs" value="@b.BlockID" class="edit-block-check"> @b.BName (@b.DormitoryName)</label>
                            }
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-warning">ذخیره</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">انصراف</button>
            </form>
        </div>
    </div>

    <script>
            function openAddModal() {
                document.getElementById('addModal').style.display = 'flex';
                document.getElementById('addBlockSection').style.display = 'none';
                document.querySelector('#addModal select[name="UserRole"]').value = 'مدیر';
            }
            function closeModal(id) { document.getElementById(id).style.display = 'none'; }
            function openEditModal(id, fname, lname, nid, gender, mobile, email, role, shift, workplace) {
                document.getElementById('editPID').value = id;
                document.getElementById('editFName').value = fname;
                document.getElementById('editLName').value = lname;
                document.getElementById('editNID').value = nid;
                document.getElementById('editGender').value = gender;
                document.getElementById('editMobile').value = mobile;
                document.getElementById('editEmail').value = email || '';
                document.getElementById('editRoleSelect').value = role;
                document.getElementById('editShift').value = shift || '';
                document.getElementById('editWorkplace').value = workplace || '';
                const blockSection = document.getElementById('editBlockSection');
                blockSection.style.display = role === 'سرپرست' ? 'flex' : 'none';
                if (role === 'سرپرست') {
                    const supervisorBlocks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SupervisorBlocks ?? new Dictionary<int, List<int>>()));
                    const blockChecks = document.querySelectorAll('.edit-block-check');
                    const currentBlocks = supervisorBlocks[id] || [];
                    blockChecks.forEach(cb => { cb.checked = currentBlocks.includes(parseInt(cb.value)); });
                } else {
                    document.querySelectorAll('.edit-block-check').forEach(cb => cb.checked = false);
                }
                document.getElementById('editModal').style.display = 'flex';
            }
            document.getElementById('addRoleSelect').addEventListener('change', function() {
                document.getElementById('addBlockSection').style.display = this.value === 'سرپرست' ? 'flex' : 'none';
            });
            document.getElementById('editRoleSelect').addEventListener('change', function() {
                document.getElementById('editBlockSection').style.display = this.value === 'سرپرست' ? 'flex' : 'none';
            });
            window.onclick = function(event) { if (event.target.classList.contains('modal-overlay')) event.target.style.display = 'none'; }
    </script>
</body>
</html>