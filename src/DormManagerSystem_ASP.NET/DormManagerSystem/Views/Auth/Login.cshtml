@{
    ViewData["Title"] = "ورود";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ورود | سامانه خوابگاه</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', 'Tahoma', sans-serif;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                position: relative;
            }

            .aura {
                position: absolute;
                border-radius: 50%;
                filter: blur(80px);
                opacity: 0.5;
                z-index: 0;
            }

            .aura-1 {
                width: 400px;
                height: 400px;
                background: rgba(138, 43, 226, 0.35);
                top: -100px;
                left: -80px;
            }

            .aura-2 {
                width: 350px;
                height: 350px;
                background: rgba(70, 130, 220, 0.4);
                bottom: -120px;
                right: -60px;
            }

            .aura-3 {
                width: 250px;
                height: 250px;
                background: rgba(255, 255, 255, 0.3);
                top: 50%;
                left: 60%;
                transform: translate(-50%, -50%);
            }

            .login-card {
                position: relative;
                z-index: 1;
                background: rgba(255, 255, 255, 0.92);
                backdrop-filter: blur(15px);
                border-radius: 24px;
                padding: 2.5rem 2rem;
                width: 90%;
                max-width: 420px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
                text-align: center;
            }

                .login-card h2 {
                    font-size: 2rem;
                    font-weight: 700;
                    color: #4a3a6e;
                    margin-bottom: 0.5rem;
                }

                .login-card .subtitle {
                    font-size: 0.9rem;
                    color: #666;
                    margin-bottom: 2rem;
                }

            .input-group {
                margin-bottom: 1.5rem;
                text-align: right;
            }

                .input-group label {
                    display: block;
                    font-weight: 600;
                    color: #444;
                    margin-bottom: 0.4rem;
                    font-size: 0.9rem;
                }

                .input-group input {
                    width: 100%;
                    padding: 0.9rem 1rem;
                    border: 2px solid #e0e0e0;
                    border-radius: 14px;
                    font-size: 1rem;
                    font-family: inherit;
                    transition: all 0.3s ease;
                    background: #fafafa;
                    outline: none;
                }

                    .input-group input:focus {
                        border-color: #764ba2;
                        box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.15);
                        background: #fff;
                    }

            .error-message {
                background: #ffe3e3;
                color: #d32f2f;
                padding: 0.7rem 1rem;
                border-radius: 12px;
                margin-bottom: 1.2rem;
                font-size: 0.9rem;
                border: 1px solid #ffcdd2;
            }

            .btn-login {
                width: 100%;
                padding: 0.9rem;
                background: linear-gradient(135deg, #667eea, #764ba2);
                color: white;
                border: none;
                border-radius: 14px;
                font-size: 1.1rem;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.3s ease;
                letter-spacing: 0.5px;
                box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
                margin-top: 0.5rem;
            }

                .btn-login:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 28px rgba(102, 126, 234, 0.55);
                }

                .btn-login:active {
                    transform: translateY(0);
                }

            @@media (max-width: 480px) {
                .login-card {
                    padding: 2rem 1.5rem;
                }

                    .login-card h2 {
                        font-size: 1.6rem;
                    }
            }
    </style>
</head>
<body>
    <div class="aura aura-1"></div>
    <div class="aura aura-2"></div>
    <div class="aura aura-3"></div>

    <div class="login-card">
        <h2>🔐 ورود به سامانه</h2>
        <p class="subtitle">سامانه مدیریت خوابگاه دانشجویی</p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">⚠️ @ViewBag.Error</div>
        }

        <form method="post">
            <div class="input-group">
                <label>📧 ایمیل سازمانی</label>
                <input type="email" name="email" placeholder="example@dorm.ac.ir" required autofocus>
            </div>
            <div class="input-group">
                <label>🔒 رمز عبور</label>
                <input type="password" name="password" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn-login">ورود به پنل</button>
        </form>
    </div>
</body>
</html>