@model IEnumerable<DormWeb.Models.SupervisorPaymentItem>
@{
    ViewData["Title"] = "پرداخت‌ها";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پرداخت‌ها | دانشجو</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #6f42c1;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold
            }

            .user-details small {
                display: block;
                color: #666
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    color: #6f42c1;
                    margin-bottom: .5rem
                }

                .sidebar a {
                    display: block;
                    background: #6f42c1;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s
                }

                    .sidebar a:hover {
                        background: #59339d
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem
            }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold
            }

            .btn-success {
                background: #28a745;
                color: white
            }

            table {
                width: 100%;
                border-collapse: collapse
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right
            }

            th {
                background: #f8f8f8
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@(ViewBag.StudentFirstName?.ToString()?.Substring(0, 1))</div>
            <div class="user-details"><strong>@ViewBag.StudentFirstName @ViewBag.StudentLastName</strong><small>شماره: @ViewBag.StudentID</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل دانشجو</h2>
            <a href="/Student/Index"> داشبورد</a>
            <a href="/Student/CreateGroup"> تشکیل گروه</a>
            <a href="/Student/ReserveRoom"> رزرو اتاق</a>
            <a href="/Student/Payments" style="background:#59339d;"> پرداخت‌ها</a>
            <a href="/Student/Reports"> گزارش‌ها</a>
            <a href="/Student/Profile"> پروفایل</a>
            <a href="/Student/ResidenceInfo"> اطلاعات سکونت</a>
            <a href="/Student/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            @if (TempData["Msg"] != null)
            {
                <div style="background:#d4edda;color:#155724;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Msg"]</div>
            }
            <div class="card">
                <h3>💰 پرداخت‌های در انتظار</h3>
                <table>
                    <thead><tr><th>کد</th><th>عنوان</th><th>تاریخ</th><th>وضعیت</th><th></th></tr></thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>@p.TransactionID</td>
                                    <td>@p.Title</td>
                                    <td>@p.Date.ToString("yyyy/MM/dd")</td>
                                    <td>@p.PaymentStatus</td>
                                    <td>
                                        <form method="post" action="/Student/Pay">
                                            <input type="hidden" name="transactionId" value="@p.TransactionID">
                                            <button type="submit" class="btn btn-success">پرداخت</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" style="text-align:center;padding:2rem;">پرداختی در انتظار وجود ندارد.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>