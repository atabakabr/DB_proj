@model DormWeb.Models.GuardInfoViewModel
@{
    ViewData["Title"] = "پروفایل";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پروفایل | دانشجو</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #6f42c1;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold
            }

            .user-details small {
                display: block;
                color: #666
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    color: #6f42c1;
                    margin-bottom: .5rem
                }

                .sidebar a {
                    display: block;
                    background: #6f42c1;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s
                }

                    .sidebar a:hover {
                        background: #59339d
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem
            }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold
            }

            .btn-primary {
                background: #6f42c1;
                color: white
            }

            .field-group {
                display: flex;
                flex-wrap: wrap;
                gap: 1rem;
                margin-bottom: 1rem
            }

            .field {
                flex: 1 1 280px
            }

                .field label {
                    display: block;
                    font-weight: bold;
                    margin-bottom: .3rem
                }

                .field input {
                    width: 100%;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px
                }

            .non-editable {
                background: #e9ecef
            }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@(Model?.FirstName?.Substring(0, 1))</div>
            <div class="user-details"><strong>@Model?.FirstName @Model?.LastName</strong><small>شماره: @Model?.PersonnelID</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل دانشجو</h2>
            <a href="/Student/Index"> داشبورد</a>
            <a href="/Student/CreateGroup"> تشکیل گروه</a>
            <a href="/Student/ReserveRoom"> رزرو اتاق</a>
            <a href="/Student/Payments"> پرداخت‌ها</a>
            <a href="/Student/Reports"> گزارش‌ها</a>
            <a href="/Student/Profile" style="background:#59339d;"> پروفایل</a>
            <a href="/Student/ResidenceInfo"> اطلاعات سکونت</a>
            <a href="/Student/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            @if (ViewBag.SuccessMessage != null)
            {
                <div style="background:#d4edda;color:#155724;padding:.5rem;border-radius:4px;margin-bottom:1rem">@ViewBag.SuccessMessage</div>
            }
            <div class="card">
                <h2>اطلاعات فردی</h2>
                <form method="post">
                    <div class="field-group">
                        <div class="field"><label>شماره دانشجویی</label><input class="non-editable" value="@Model?.PersonnelID" readonly></div>
                        <div class="field"><label>نام</label><input class="non-editable" value="@Model?.FirstName" readonly></div>
                        <div class="field"><label>نام خانوادگی</label><input class="non-editable" value="@Model?.LastName" readonly></div>
                    </div>
                    <div class="field-group">
                        <div class="field"><label>کد ملی</label><input class="non-editable" value="@Model?.NationalID" readonly></div>
                        <div class="field"><label>جنسیت</label><input class="non-editable" value="@(Model?.Gender == "M" ? "مرد" : "زن")" readonly></div>
                        <div class="field"><label>تاریخ تولد</label><input class="non-editable" value="@(Model?.BirthDate.ToString("yyyy/MM/dd"))" readonly></div>
                    </div>
                    <div class="field-group">
                        <div class="field"><label>رشته</label><input class="non-editable" value="@Model?.UserRole" readonly></div>
                        <div class="field"><label>موبایل</label><input type="text" name="MobilePhoneNumber" value="@Model?.MobilePhoneNumber"></div>
                        <div class="field"><label>ایمیل</label><input type="email" name="OrganizationalEmail" value="@Model?.OrganizationalEmail"></div>
                    </div>
                    <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>