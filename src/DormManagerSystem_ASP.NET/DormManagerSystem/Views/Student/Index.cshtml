@model IEnumerable<DormWeb.Models.AnnouncementItem>
@{
    ViewData["Title"] = "داشبورد دانشجو";
    Layout = null;
}
@if (TempData["Msg"] != null)
{
    <div style="background:#d4edda;color:#155724;padding:.5rem;border-radius:4px;margin-bottom:1rem">
        @TempData["Msg"]
    </div>
}
@if (TempData["Err"] != null)
{
    <div style="background:#f8d7da;color:#721c24;padding:.5rem;border-radius:4px;margin-bottom:1rem">
        @TempData["Err"]
    </div>
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>داشبورد | دانشجو</title>
    <style>
            *{box-sizing:border-box;margin:0;padding:0}body{font-family:Tahoma,sans-serif;background:#f4f6f9}
            .top-bar{background:#fff;border-bottom:1px solid #ddd;padding:.5rem 1rem;display:flex;justify-content:space-between;align-items:center}
            .user-info{display:flex;align-items:center;gap:.75rem}.user-avatar{width:40px;height:40px;background:#6f42c1;color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold}
            .user-details small{display:block;color:#666;font-size:.75rem}.user-details strong{font-size:.95rem}
            .logout-btn{background:#dc3545;color:white;border:none;padding:.4rem 1rem;border-radius:4px;cursor:pointer;text-decoration:none}
            .container{display:flex;flex-direction:row-reverse;min-height:calc(100vh - 50px)}
            .sidebar{width:250px;background:#fff;border-left:1px solid #ddd;padding:1.5rem 1rem;display:flex;flex-direction:column;gap:.5rem}
            .sidebar h2{text-align:center;font-size:1.3rem;color:#6f42c1;margin-bottom:.5rem}
            .sidebar a{display:block;background:#6f42c1;color:white;text-decoration:none;padding:.6rem 1rem;border-radius:6px;text-align:center;transition:background .2s}
            .sidebar a:hover{background:#59339d}
            .main{flex:1;padding:2rem}
            .announce-card{background:white;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.08);padding:1.5rem}
            .announce-item{padding:.75rem;border-bottom:1px solid #eee}
            .announce-item:last-child{border-bottom:none}
            .announce-title{font-weight:bold;color:#333}
            .announce-date{font-size:.8rem;color:#888;margin-bottom:.5rem}
            .no-data{text-align:center;padding:2rem;color:#888}
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@(ViewBag.StudentFirstName?.ToString()?.Substring(0, 1))</div>
            <div class="user-details">
                <strong>@ViewBag.StudentFirstName @ViewBag.StudentLastName</strong>
                <small>شماره دانشجویی: @ViewBag.StudentID</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل دانشجو</h2>
            <a href="/Student/Index" style="background:#59339d;"> داشبورد</a>
            <a href="/Student/CreateGroup"> تشکیل گروه</a>
            <a href="/Student/ReserveRoom"> رزرو اتاق</a>
            <a href="/Student/Payments"> پرداخت‌ها</a>
            <a href="/Student/Reports"> گزارش‌ها</a>
            <a href="/Student/Profile"> پروفایل</a>
            <a href="/Student/ResidenceInfo"> اطلاعات سکونت</a>
            <a href="/Student/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            <h2>آخرین اطلاعیه‌ها</h2>
            <div class="announce-card">
                @if (Model != null && Model.Any())
                {
                    @foreach (var a in Model)
                    {
                        <div class="announce-item">
                            <div class="announce-title">@a.Title</div>
                            <div class="announce-date">@a.Date.ToString("yyyy/MM/dd") | انقضا: @a.EXPDate.ToString("yyyy/MM/dd")</div>
                            <p>@a.Description</p>
                        </div>
                    }
                }
                else
                {
                    <div class="no-data">هیچ اطلاعیه‌ای وجود ندارد.</div>
                }
            </div>
        </div>
    </div>
</body>
</html>