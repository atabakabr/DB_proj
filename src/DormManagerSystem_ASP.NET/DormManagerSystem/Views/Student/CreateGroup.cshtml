@{
    ViewData["Title"] = "تشکیل / ویرایش گروه";
    Layout = null;

    var members = ViewBag.Members as List<int> ?? new List<int>();
    bool isEditing = ViewBag.IsEditing ?? false;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تشکیل / ویرایش گروه | دانشجو</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        body {
            font-family: Tahoma,sans-serif;
            background: #f4f6f9
        }

        .top-bar {
            background: #fff;
            border-bottom: 1px solid #ddd;
            padding: .5rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: .75rem
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            background: #6f42c1;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold
        }

        .user-details small {
            display: block;
            color: #666
        }

        .user-details strong {
            font-size: .95rem
        }

        .logout-btn {
            background: #dc3545;
            color: white;
            border: none;
            padding: .4rem 1rem;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none
        }

        .container {
            display: flex;
            flex-direction: row-reverse;
            min-height: calc(100vh - 50px)
        }

        .sidebar {
            width: 250px;
            background: #fff;
            border-left: 1px solid #ddd;
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            gap: .5rem
        }

        .sidebar h2 {
            text-align: center;
            font-size: 1.3rem;
            color: #6f42c1;
            margin-bottom: .5rem
        }

        .sidebar a {
            display: block;
            background: #6f42c1;
            color: white;
            text-decoration: none;
            padding: .6rem 1rem;
            border-radius: 6px;
            text-align: center;
            transition: background .2s
        }

        .sidebar a:hover {
            background: #59339d
        }

        .main {
            flex: 1;
            padding: 2rem
        }

        .card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
            padding: 1.5rem
        }

        .btn {
            padding: .5rem 1rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold
        }

        .btn-primary {
            background: #6f42c1;
            color: white
        }

        .btn-success {
            background: #28a745;
            color: white
        }

        .btn-danger {
            background: #dc3545;
            color: white
        }

        .form-row {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
            flex-wrap: wrap
        }

        .form-group {
            flex: 1 1 200px;
            margin-bottom: .5rem
        }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: .3rem
        }

        .form-group input {
            width: 100%;
            padding: .5rem;
            border: 1px solid #ccc;
            border-radius: 4px
        }

        .member-list {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            margin-top: .5rem
        }

        .member-tag {
            background: #e7f3ff;
            padding: .3rem .6rem;
            border-radius: 6px;
            font-size: .85rem;
            display: flex;
            align-items: center;
            gap: .5rem
        }

        .member-tag button {
            background: none;
            border: none;
            color: red;
            cursor: pointer;
            font-weight: bold
        }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@(ViewBag.StudentFirstName?.ToString()?.Substring(0, 1))</div>
            <div class="user-details">
                <strong>@ViewBag.StudentFirstName @ViewBag.StudentLastName</strong>
                <small>شماره دانشجویی: @ViewBag.StudentID</small>
            </div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل دانشجو</h2>
            <a href="/Student/Index"> داشبورد</a>
            <a href="/Student/CreateGroup" style="background:#59339d;"> تشکیل گروه</a>
            <a href="/Student/ReserveRoom"> رزرو اتاق</a>
            <a href="/Student/Payments"> پرداخت‌ها</a>
            <a href="/Student/Reports"> گزارش‌ها</a>
            <a href="/Student/Profile"> پروفایل</a>
            <a href="/Student/ResidenceInfo"> اطلاعات سکونت</a>
            <a href="/Student/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            @if (TempData["Msg"] != null)
            {
                <div style="background:#d4edda;color:#155724;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Msg"]</div>
            }
            @if (TempData["Err"] != null)
            {
                <div style="background:#f8d7da;color:#721c24;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Err"]</div>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <div style="background:#f8d7da;color:#721c24;padding:.5rem;border-radius:4px;margin-bottom:1rem">@ViewBag.ErrorMessage</div>
            }

            <div class="card">
                <h3>@(isEditing ? "✏️ ویرایش اعضای گروه" : "➕ تشکیل گروه جدید")</h3>
                <p>@(isEditing ? $"گروه شماره: {ViewBag.GroupId}" : "حداقل ۳ نفر (شامل خودتان) با جنسیت یکسان برای تشکیل گروه الزامی است.")</p>

                <form method="post" action="@(isEditing ? "/Student/EditGroup" : "/Student/CreateGroup")" id="createGroupForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label>شماره دانشجویی عضو</label>
                            <div style="display:flex;gap:.5rem">
                                <input type="number" id="newStudentId" placeholder="مثلاً 403521001" style="flex:1">
                                <button type="button" class="btn btn-primary" onclick="addMember()">➕</button>
                            </div>
                        </div>
                    </div>
                    
                    <div id="memberList" class="member-list"></div>
                    
                    <div id="hiddenInputsContainer"></div>

                    <button type="submit" class="btn btn-success" style="margin-top:1rem">
                        @(isEditing ? "💾 ذخیره تغییرات" : "✅ ایجاد گروه")
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        let members = [];
        @if (isEditing)
        {
            <text>
                members = [@Html.Raw(string.Join(",", members))];
            </text>
        }
        else
        {
            <text>
                members = [Number(@ViewBag.StudentID)];
            </text>
        }
        
        renderMembers();

        function addMember() {
            const input = document.getElementById('newStudentId');
            const val = input.value.trim();
            
            if (!val || isNaN(val)) { alert('لطفاً یک شماره معتبر وارد کنید'); return; }
            
            const sid = Number(val);
            
            if (members.includes(sid)) { alert('این شماره قبلاً اضافه شده است'); return; }
            
            members.push(sid);
            renderMembers();
            input.value = '';
        }

        function removeMember(sid) {
            if (sid == Number(@ViewBag.StudentID)) { alert('شما نمی‌توانید خودتان را حذف کنید.'); return; }
            members = members.filter(m => m != sid);
            renderMembers();
        }

        function renderMembers() {
            const myId = Number(@ViewBag.StudentID);
            
            const container = document.getElementById('memberList');
            container.innerHTML = members.map(m =>
                `<span class="member-tag">${m}${m === myId ? ' (شما)' : ''} <button type="button" onclick="removeMember(${m})">✖</button></span>`
            ).join('');
            
            const hiddenContainer = document.getElementById('hiddenInputsContainer');
            hiddenContainer.innerHTML = members.map(m => 
                `<input type="hidden" name="studentIds" value="${m}">`
            ).join('');
        }

        document.getElementById('createGroupForm').addEventListener('submit', function(e) {
            if (members.length < 3) {
                e.preventDefault();
                alert('گروه باید حداقل ۳ نفر داشته باشد.');
            }
        });
    </script>
</body>
</html>