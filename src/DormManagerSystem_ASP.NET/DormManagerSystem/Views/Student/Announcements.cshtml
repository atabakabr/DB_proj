@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "اطلاعیه‌ها";
    Layout = null;
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var prevDisabled = currentPage <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = currentPage >= totalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>اطلاعیه‌ها | دانشجو</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #6f42c1;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold
            }

            .user-details small {
                display: block;
                color: #666
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    color: #6f42c1;
                    margin-bottom: .5rem
                }

                .sidebar a {
                    display: block;
                    background: #6f42c1;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s
                }

                    .sidebar a:hover {
                        background: #59339d
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem
            }

            table {
                width: 100%;
                border-collapse: collapse
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right
            }

            th {
                background: #f8f8f8
            }

            .badge {
                display: inline-block;
                padding: .2rem .8rem;
                border-radius: 20px;
                font-size: .8rem;
                color: white
            }

            .badge-personal {
                background: #e83e8c
            }

            .badge-block {
                background: #6f42c1
            }

            .badge-dormitory {
                background: #fd7e14
            }

            .pagination {
                display: flex;
                justify-content: center;
                gap: .5rem;
                margin-top: 1rem
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333
                }

                    .pagination a:hover {
                        background: #6f42c1;
                        color: white
                    }

                .pagination .current {
                    background: #6f42c1;
                    color: white
                }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@(ViewBag.StudentFirstName?.ToString()?.Substring(0, 1))</div>
            <div class="user-details"><strong>@ViewBag.StudentFirstName @ViewBag.StudentLastName</strong><small>شماره: @ViewBag.StudentID</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل دانشجو</h2>
            <a href="/Student/Index"> داشبورد</a>
            <a href="/Student/CreateGroup"> تشکیل گروه</a>
            <a href="/Student/ReserveRoom"> رزرو اتاق</a>
            <a href="/Student/Payments"> پرداخت‌ها</a>
            <a href="/Student/Reports"> گزارش‌ها</a>
            <a href="/Student/Profile"> پروفایل</a>
            <a href="/Student/ResidenceInfo"> اطلاعات سکونت</a>
            <a href="/Student/Announcements" style="background:#59339d;"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            <div class="card">
                <h3>📢 اطلاعیه‌های من</h3>
                <table>
                    <thead><tr><th>کد</th><th>عنوان</th><th>تاریخ</th><th>انقضا</th><th>نوع</th><th>توضیحات</th></tr></thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var a in Model)
                            {
                                string badgeClass = a.TargetType == "شخصی" ? "badge-personal" : a.TargetType == "بلوک" ? "badge-block" : "badge-dormitory";
                                <tr>
                                    <td>@a.AnnouncementID</td>
                                    <td>@a.Title</td>
                                    <td>@a.Date.ToString("yyyy/MM/dd")</td>
                                    <td>@a.EXPDate.ToString("yyyy/MM/dd")</td>
                                    <td><span class="badge @badgeClass">@a.TargetType</span></td>
                                    <td>@a.Description</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="text-align:center;padding:2rem;">اطلاعیه‌ای یافت نشد.</td></tr>
                        }
                    </tbody>
                </table>
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Student/Announcements?page=@(currentPage - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == currentPage)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Student/Announcements?page=@i">@i</a>
                            }
                        }
                        <a href="/Student/Announcements?page=@(currentPage + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center;margin-top:.5rem;color:#888;">نمایش @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>
</body>
</html>