@model IEnumerable<DormWeb.Models.SupervisorReportItem>
@{
    ViewData["Title"] = "گزارش‌ها";
    Layout = null;
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var prevDisabled = currentPage <= 1 ? "style='pointer-events: none; opacity: 0.5;'" : "";
    var nextDisabled = currentPage >= totalPages ? "style='pointer-events: none; opacity: 0.5;'" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>گزارش‌ها | دانشجو</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            body {
                font-family: Tahoma,sans-serif;
                background: #f4f6f9
            }

            .top-bar {
                background: #fff;
                border-bottom: 1px solid #ddd;
                padding: .5rem 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: .75rem
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #6f42c1;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold
            }

            .user-details small {
                display: block;
                color: #666
            }

            .user-details strong {
                font-size: .95rem
            }

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                padding: .4rem 1rem;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none
            }

            .container {
                display: flex;
                flex-direction: row-reverse;
                min-height: calc(100vh - 50px)
            }

            .sidebar {
                width: 250px;
                background: #fff;
                border-left: 1px solid #ddd;
                padding: 1.5rem 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem
            }

                .sidebar h2 {
                    text-align: center;
                    font-size: 1.3rem;
                    color: #6f42c1;
                    margin-bottom: .5rem
                }

                .sidebar a {
                    display: block;
                    background: #6f42c1;
                    color: white;
                    text-decoration: none;
                    padding: .6rem 1rem;
                    border-radius: 6px;
                    text-align: center;
                    transition: background .2s
                }

                    .sidebar a:hover {
                        background: #59339d
                    }

            .main {
                flex: 1;
                padding: 2rem
            }

            .card {
                background: white;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
                padding: 1.5rem;
                margin-bottom: 1.5rem
            }

            .btn {
                padding: .5rem 1rem;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold
            }

            .btn-primary {
                background: #6f42c1;
                color: white
            }

            .btn-success {
                background: #28a745;
                color: white
            }

            .form-row {
                display: flex;
                gap: 1rem;
                align-items: flex-end;
                flex-wrap: wrap
            }

            .form-group {
                flex: 1 1 200px;
                margin-bottom: .5rem
            }

                .form-group label {
                    display: block;
                    font-weight: bold;
                    margin-bottom: .3rem
                }

                .form-group input, .form-group select {
                    width: 100%;
                    padding: .5rem;
                    border: 1px solid #ccc;
                    border-radius: 4px
                }

            table {
                width: 100%;
                border-collapse: collapse
            }

            th, td {
                padding: .6rem;
                border-bottom: 1px solid #eee;
                text-align: right
            }

            th {
                background: #f8f8f8
            }

            .pagination {
                display: flex;
                justify-content: center;
                gap: .5rem;
                margin-top: 1rem
            }

                .pagination a, .pagination span {
                    padding: .4rem .8rem;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    text-decoration: none;
                    color: #333
                }

                    .pagination a:hover {
                        background: #6f42c1;
                        color: white
                    }

                .pagination .current {
                    background: #6f42c1;
                    color: white
                }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="user-info">
            <div class="user-avatar">@(ViewBag.StudentFirstName?.ToString()?.Substring(0, 1))</div>
            <div class="user-details"><strong>@ViewBag.StudentFirstName @ViewBag.StudentLastName</strong><small>شماره: @ViewBag.StudentID</small></div>
        </div>
        <a href="/Auth/Logout" class="logout-btn">خروج</a>
    </div>
    <div class="container">
        <div class="sidebar">
            <h2>پنل دانشجو</h2>
            <a href="/Student/Index"> داشبورد</a>
            <a href="/Student/CreateGroup"> تشکیل گروه</a>
            <a href="/Student/ReserveRoom"> رزرو اتاق</a>
            <a href="/Student/Payments"> پرداخت‌ها</a>
            <a href="/Student/Reports" style="background:#59339d;"> گزارش‌ها</a>
            <a href="/Student/Profile"> پروفایل</a>
            <a href="/Student/ResidenceInfo"> اطلاعات سکونت</a>
            <a href="/Student/Announcements"> اطلاعیه‌ها</a>
        </div>
        <div class="main">
            @if (TempData["Msg"] != null)
            {
                <div style="background:#d4edda;color:#155724;padding:.5rem;border-radius:4px;margin-bottom:1rem">@TempData["Msg"]</div>
            }

            <div class="card">
                <h3>📝 ثبت گزارش جدید</h3>
                <form method="post" action="/Student/SubmitReport">
                    <div class="form-row">
                        <div class="form-group"><label>عنوان</label><input type="text" name="Title" required></div>
                        <div class="form-group"><label>نوع</label><select name="Type"><option>فنی</option><option>انضباطی</option><option>تجهیزات</option><option>امنیتی</option><option>محیطی</option></select></div>
                        <div class="form-group"><label>هدف</label><input type="text" name="Target" placeholder="مثلاً اتاق 101" required></div>
                    </div>
                    <div class="form-group"><label>توضیحات</label><textarea name="Description" rows="3" style="width:100%;padding:.5rem;border:1px solid #ccc;border-radius:4px"></textarea></div>
                    <button type="submit" class="btn btn-success" style="margin-top:1rem">ارسال گزارش</button>
                </form>
            </div>

            <div class="card">
                <h3>📋 گزارش‌های قبلی</h3>
                <table>
                    <thead><tr><th>کد</th><th>عنوان</th><th>نوع</th><th>تاریخ</th><th>هدف</th><th>توضیحات</th></tr></thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var r in Model)
                            {
                                <tr><td>@r.RID</td><td>@r.Title</td><td>@r.Type</td><td>@r.Date.ToString("yyyy/MM/dd")</td><td>@r.Target</td><td>@r.Description</td></tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="text-align:center;padding:2rem;">گزارشی وجود ندارد.</td></tr>
                        }
                    </tbody>
                </table>
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <a href="/Student/Reports?page=@(currentPage - 1)" @Html.Raw(prevDisabled)>قبلی</a>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == currentPage)
                            {
                                <span class="current">@i</span>
                            }
                            else
                            {

                                <a href="/Student/Reports?page=@i">@i</a>
                            }
                        }
                        <a href="/Student/Reports?page=@(currentPage + 1)" @Html.Raw(nextDisabled)>بعدی</a>
                    </div>
                    <div style="text-align:center;margin-top:.5rem;color:#888;">نمایش @(Model?.Count() ?? 0) از @ViewBag.TotalCount</div>
                }
            </div>
        </div>
    </div>
</body>
</html>